# Generated by devenv:makefile-gen -- `make` prints the targets.
# Regenerate: /devenv:makefile-gen --apply --force (keeps Makefile.bak).

SYNC := sync

.DEFAULT_GOAL := help
.PHONY: help setup build run test up down clear clean

help: ## 이 도움말
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z0-9_-]+:.*## / {printf "  make %-10s %s\n", $$1, $$2}' $(MAKEFILE_LIST)

setup: ## 최초 1회: 의존성 설치
	cd $(SYNC) && uv $(SYNC)

build: ## 빌드 단계 없음(no-op)
	@echo "빌드 단계 없음"

run: ## 실행 명령 없음(no-op) -- 직접 채운다
	@echo "실행 명령 없음 -- Makefile 의 run 을 채운다"

test: ## 단위 테스트
	cd $(SYNC) && mise run test

up: ## docker compose 기동
	docker compose -f docker-compose.yml up -d

down: ## docker compose 종료
	docker compose -f docker-compose.yml down

clear: ## 빌드·테스트 산출물 정리(의존성·비밀·데이터는 남긴다)
	rm -rf $(SYNC)/.pytest_cache

clean: clear ## clear 와 같다

# --- custom (kept by makefile-gen) ---
.PHONY: tunnel tunnel-logs

tunnel: ## Funnel(tailscale, profile tunnel) 기동 + 로그 50줄
	docker compose --profile tunnel up -d tailscale
	docker compose logs --tail 50 tailscale

tunnel-logs: ## Funnel 로그 50줄
	docker compose logs --tail 50 tailscale
